{
  "name": "geocoach",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geocoach",
      "database_id": "4a2ece03-b45c-4625-86cb-863a77ad7c19"
    }
  ],
  // The public site (Vite build in dist-site/). run_worker_first so the Worker
  // owns the API routes and gets to serve the SPA fallback itself.
  "assets": {
    "directory": "../dist-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // The userscript (and its loader) are served from GET /geocoach.user.js and
  // /geocoach.body.js with the caller's credentials baked in, so both bundle
  // as text. The boundary packs do NOT bundle any more — at their 2026-08 size
  // they blew the free plan's 3 MiB script cap, so build:site copies them into
  // dist-site/geo/ and the Worker fetches them from ASSETS once per isolate.
  "rules": [
    { "type": "Text", "globs": ["**/*.user.js", "**/*.loader.js"], "fallthrough": true }
  ],
  // Re-enable once R2 is switched on for the account (dashboard > R2, one-time
  // terms acceptance), then: wrangler r2 bucket create geocoach && wrangler deploy
  // "r2_buckets": [{ "binding": "STORE", "bucket_name": "geocoach" }]
  "r2_buckets": []
}
